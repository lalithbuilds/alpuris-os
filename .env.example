# ==============================================================================
# BENGALURU LIVING AGENT METROPOLIS OS — ENVIRONMENT TEMPLATE
# Copy to .env and populate with your credentials.
# The simulation runs fully offline with heuristic synthesis if no keys are set.
# ==============================================================================

# HTTP & Server Configuration
PORT=9090
HOST=0.0.0.0
TICK_INTERVAL_SEC=3.5
AUTO_RUNNING=true

# NVIDIA NIM API (81 Models acceleration)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
GOVERNANCE_MODEL=openai/gpt-oss-20b

# Lumino AI Compute (Decentralized GPU inference)
LUMINO_AI_API_KEY=your_lumino_ai_api_key_here
LUMINO_URL=https://api.luminoai.co.in/api/v1/chat/completions
LUMINO_CONCURRENCY_MODEL=mimo-2-5

# OpenRouter Tiered Failover (Multiple keys supported via comma-separation)
OPENROUTER_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MODEL=z-ai/glm-5.2

# Indic Language Foundation Models
KRUTRIM_API_KEY=your_krutrim_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Local Offline Fallback (Ollama / vLLM / LM Studio)
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen2.5:7b
